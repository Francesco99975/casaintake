package views

import (
	"github.com/Francesco99975/casaintake/internal/config"
	"github.com/Francesco99975/casaintake/views/icons"
	"github.com/Francesco99975/casaintake/views/layouts"
	"github.com/Francesco99975/casaintake/views/ui"
)

// AuthGate is the passkey wall that protects the patient intake form.
// UI/UX only — wire up the hx-post endpoint, session, and redirect separately.
//
// Collected field:
//   passkey (clinical passkey / password)
templ Index(site config.Site) {
	@layouts.Base(site) {
		<main class="flex-1 w-full flex items-center justify-center">
			<!-- Theme toggle, pinned top-right -->
			<div class="fixed top-4 right-4 z-20">
				@ui.ThemeToggle()
			</div>
			<!-- Ambient background accents -->
			<div class="pointer-events-none fixed inset-0 overflow-hidden" aria-hidden="true">
				<div class="absolute -top-24 -left-24 h-72 w-72 rounded-full bg-primary/15 blur-3xl"></div>
				<div class="absolute -bottom-32 -right-16 h-80 w-80 rounded-full bg-accent/15 blur-3xl"></div>
			</div>
			<div class="relative w-full max-w-md px-4 py-10 sm:py-16">
				<!-- Brand mark -->
				<div class="mb-6 flex justify-center">
					<span class="inline-flex h-14 w-14 items-center justify-center rounded-2xl bg-primary text-primary-fg shadow-lg">
						@icons.Lock("h-7 w-7")
					</span>
				</div>
				<!-- Card -->
				<form
					id="auth-form"
					class="card relative p-6 sm:p-8"
					hx-post="/authorize"
					hx-swap="none"
					{ ui.WithLoading("auth-loading")... }
				>
					<header class="text-center">
						<span class="inline-flex items-center gap-2 rounded-full bg-primary/10 px-3 py-1 text-xs font-semibold uppercase tracking-wide text-primary">
							<span class="pulse-dot"></span>
							Restricted Access
						</span>
						<h1 class="mt-4 text-xl sm:text-2xl font-bold text-fg text-balance">
							Use Clinical Passkey to Authorize Patients Intake
						</h1>
						<p class="mt-2 text-sm text-muted leading-relaxed text-pretty">
							Enter your clinical passkey to unlock the patient intake form.
						</p>
					</header>
					<div class="mt-6">
						@ui.SecurePasswordInput(ui.PasswordProps{
							Name:        "passkey",
							Label:       "Clinical passkey",
							Placeholder: "Enter passkey",
							Required:    true,
							Attrs:       templ.Attributes{"autocomplete": "current-password", "autofocus": true},
						})
					</div>
					<div class="mt-6">
						@ui.Button(ui.ButtonProps{
							Variant: ui.ButtonPrimary,
							Size:    ui.ButtonLG,
							Type:    ui.TypeSubmit,
							FullW:   true,
							Loading: ui.LoadingConfig{IndicatorID: "auth-loading", Text: "Verifying…"},
						}) {
							@icons.Lock("h-4 w-4")
							Authorize Intake
						}
					</div>
				</form>
				<p class="mt-6 text-center text-xs text-muted">
					Authorized clinic staff only. All access is logged.
				</p>
			</div>
		</main>
	}
}

templ PatientIntakeForm(site config.Site) {
	@layouts.Base(site) {
		<main class="flex-1 w-full">
			<!-- Top utility bar: theme toggle + session logout -->
			// <div class="w-full border-b border-border bg-panel/60 backdrop-blur">
			// 	<div class="mx-auto w-full max-w-3xl px-4 py-3 flex items-center justify-between gap-3">
			// 		<span class="text-sm font-semibold text-fg">Patient Intake</span>
			// 		<div class="flex items-center gap-2">
			// 			@ui.ThemeToggle()
			// 			<form
			// 				hx-post="/logout"
			// 				hx-swap="outerHTML"
			// 				hx-indicator="#logout-spinner"
			// 				hx-disabled-elt="button"
			// 				hx-confirm="Are you sure you want to terminate the session?"
			// 				@submit="mobileMenuOpen = false"
			// 			>
			// 				@ui.Button(ui.ButtonProps{
			// 					Variant: ui.ButtonDanger,
			// 					Type:    ui.TypeSubmit,
			// 					Size:    ui.ButtonMD,
			// 					Loading: ui.LoadingConfig{IndicatorID: "logout-spinner"},
			// 				}) {
			// 					@icons.LogOut("w-5 h-5")
			// 					<span class="font-semibold hidden md:inline">Shutdown</span>
			// 				}
			// 			</form>
			// 		</div>
			// 	</div>
			// </div>
			<div class="mx-auto w-full max-w-3xl px-4 py-8 sm:py-12 md:py-16">
				<!-- Heading -->
				<header class="mb-8 text-center sm:text-left">
					<span class="inline-flex items-center gap-2 rounded-full bg-primary/10 px-3 py-1 text-xs font-semibold uppercase tracking-wide text-primary">
						<span class="pulse-dot"></span>
						New Patient
					</span>
					<h1 class="mt-4 text-2xl sm:text-3xl md:text-4xl font-bold text-fg text-balance">
						Patient Information
					</h1>
					<p class="mt-2 text-sm sm:text-base text-muted leading-relaxed text-pretty">
						Please complete the form below. Fields marked with an asterisk are required.
					</p>
				</header>
				<!-- Form -->
				<form
					id="patient-form"
					class="card relative p-5 sm:p-7 md:p-8"
					hx-post="/intake"
					hx-swap="none"
					hx-on::after-request="if(event.detail.successful){ this.reset(); this.dispatchEvent(new Event('reset', {bubbles:true})); }"
					{ ui.WithLoading("patient-loading")... }
				>
					@ui.FormLoading("patient-loading", "Saving patient information…")
					<!-- ============ SECTION: Personal details ============ -->
					<section aria-labelledby="sec-personal">
						<h2 id="sec-personal" class="text-base sm:text-lg font-semibold text-fg">
							Personal &amp; Contact
						</h2>
						<div class="mt-4 grid grid-cols-1 sm:grid-cols-2 gap-4 sm:gap-5">
							@ui.Input(ui.InputProps{
								Name:        "firstname",
								Type:        ui.InputText,
								Label:       "First name *",
								Placeholder: "First name",
								Required:    true,
								Attrs:       templ.Attributes{"autocomplete": "given-name"},
							})
							@ui.Input(ui.InputProps{
								Name:        "lastname",
								Type:        ui.InputText,
								Label:       "Last name *",
								Placeholder: "Last name",
								Required:    true,
								Attrs:       templ.Attributes{"autocomplete": "family-name"},
							})
							@ui.DateOfBirth(ui.DateOfBirthProps{
								Name:     "dob",
								Label:    "Date of birth *",
								Hint:     "Day / Month / Year",
								MaxAge:   120,
								Required: true,
							})
							@ui.PhoneInput(ui.PhoneInputProps{
								Name:           "phone",
								Label:          "Phone *",
								DefaultCountry: "CA",
								Required:       true,
								Danger:         false,
							})
							<div class="sm:col-span-2">
								@ui.Input(ui.InputProps{
									Name:        "email",
									Type:        ui.InputEmail,
									Label:       "E-mail *",
									Placeholder: "name@example.com",
									Required:    true,
									Attrs:       templ.Attributes{"autocomplete": "email"},
								})
							</div>
							<div class="sm:col-span-2">
								@ui.FracturedAddress(ui.FracturedAddressProps{
									Name:     "address",
									Legend:   "Address *",
									Hint:     "Enter your address",
									Required: true,
								})
							</div>
						</div>
					</section>
					<hr class="my-6 sm:my-7 border-border"/>
					<!-- ============ SECTION: Insurance ============ -->
					<section aria-labelledby="sec-insurance">
						<h2 id="sec-insurance" class="text-base sm:text-lg font-semibold text-fg">
							Insurance
						</h2>
						<div class="mt-4 grid grid-cols-1 gap-4 sm:gap-5">
							@ui.OHIPInput(ui.OHIPInputProps{
								Name:     "ohip",
								Label:    "OHIP number",
								Hint:     "Ontario Health Card",
								Value:    "",
								Required: false,
								Danger:   false,
							})
							@ui.Textarea(ui.TextareaProps{
								Name:        "other_insurance",
								Label:       "Other insurance information",
								Placeholder: "Provider, policy / group number, and any other coverage details",
								Rows:        3,
							})
						</div>
					</section>
					<hr class="my-6 sm:my-7 border-border"/>
					<!-- ============ SECTION: Medical history ============ -->
					<section aria-labelledby="sec-medical">
						<h2 id="sec-medical" class="text-base sm:text-lg font-semibold text-fg">
							Medical History
						</h2>
						<p class="mt-1 text-sm text-muted leading-relaxed">
							Please indicate if you have any of these conditions.
						</p>
						<div class="mt-4">
							@ui.CheckboxGroupTiles("", false,
								ui.CheckboxProps{Name: "conditions", Value: "diabetes", Label: "Diabetes"},
								ui.CheckboxProps{Name: "conditions", Value: "cholesterol", Label: "Cholesterol"},
								ui.CheckboxProps{Name: "conditions", Value: "blood_pressure", Label: "Blood Pressure"},
								ui.CheckboxProps{Name: "conditions", Value: "heart_problems", Label: "Heart Problems"},
								ui.CheckboxProps{Name: "conditions", Value: "arthritis", Label: "Arthritis"},
								ui.CheckboxProps{Name: "conditions", Value: "respiratory", Label: "Respiratory"},
								ui.CheckboxProps{Name: "conditions", Value: "hearing_issues", Label: "Hearing Issues"},
								ui.CheckboxProps{Name: "conditions", Value: "skin_conditions", Label: "Skin Conditions"},
							)
						</div>
						<div class="mt-4">
							@ui.Textarea(ui.TextareaProps{
								Name:        "other_conditions",
								Label:       "Other",
								Placeholder: "List any other conditions, allergies, or relevant medical history",
								Rows:        3,
							})
						</div>
					</section>
					<!-- ============ Actions ============ -->
					<div class="mt-8 flex flex-col-reverse sm:flex-row sm:items-center sm:justify-end gap-3">
						<button
							type="reset"
							class="btn-base w-full sm:w-auto rounded-lg border border-border bg-panel px-5 py-3 text-sm font-medium text-fg hover:bg-std"
						>
							Clear
						</button>
						<button
							type="submit"
							class="btn-base w-full sm:w-auto rounded-lg bg-primary px-6 py-3 text-sm font-semibold text-primary-fg"
						>
							Sumbit your information
						</button>
					</div>
				</form>
			</div>
		</main>
	}
}
